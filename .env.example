# Variáveis de ambiente (configure na Vercel: Settings > Environment Variables)
# NUNCA coloque estes valores no GitHub nem no js/config.js.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=chave-service_role-(secreta)

# Mercado Pago > Suas integrações > sua aplicação > Credenciais
MP_ACCESS_TOKEN=APP_USR-...
# Mercado Pago > sua aplicação > Webhooks > chave secreta
MP_WEBHOOK_SECRET=...

# Endereço final do site, sem barra no fim (opcional, mas recomendado)
SITE_URL=https://seu-site.vercel.app

# Opcional: e-mail automático de pedido pago (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Garota Mais <pedidos@seudominio.com.br>
STORE_NOTIFY_EMAIL=
